{
  "name": "checkout-api",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "lint": "eslint src --max-warnings=0",
    "test:ci": "vitest run --reporter=junit --outputFile=reports/junit.xml",
    "build": "tsc -p tsconfig.json",
    "image": "docker build -t checkout-api:${GIT_COMMIT} ."
  },
  "devDependencies": {
    "eslint": "9.17.0",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
