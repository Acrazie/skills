pipeline {
  agent { label 'linux' }

  options {
    skipDefaultCheckout(true)
  }

  environment {
    REGISTRY_HOST = 'registry.example.invalid'
    IMAGE_REPOSITORY = 'registry.example.invalid/orders'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
        script {
          if (!env.GIT_COMMIT) {
            error('checkout did not provide GIT_COMMIT')
          }
          env.IMAGE_TAG = "${env.IMAGE_REPOSITORY}:${env.GIT_COMMIT}"
        }
      }
    }

    stage('Install dependencies') {
      steps {
        sh 'composer install --no-interaction --no-progress --prefer-dist'
      }
    }

    stage('Lint') {
      steps {
        sh 'composer ci:lint'
      }
    }

    stage('Test') {
      steps {
        sh 'composer ci:test'
      }
    }

    stage('Build application') {
      steps {
        sh 'composer ci:build'
      }
    }

    stage('Build and publish image') {
      steps {
        sh 'docker build --tag "$IMAGE_TAG" .'
        withCredentials([usernamePassword(
          credentialsId: 'orders-registry',
          usernameVariable: 'REGISTRY_USERNAME',
          passwordVariable: 'REGISTRY_PASSWORD'
        )]) {
          sh '''
            set +x
            docker_config="$(mktemp -d)"
            trap 'rm -rf "$docker_config"' EXIT
            export DOCKER_CONFIG="$docker_config"
            printf '%s' "$REGISTRY_PASSWORD" | docker login \
              --username "$REGISTRY_USERNAME" \
              --password-stdin "$REGISTRY_HOST"
            docker push "$IMAGE_TAG"
          '''
        }
        script {
          def repositoryPrefix = "${env.IMAGE_REPOSITORY}@sha256:"
          def imageRef = sh(
            script: '''docker image inspect --format '{{range .RepoDigests}}{{println .}}{{end}}' "$IMAGE_TAG"''',
            returnStdout: true
          ).readLines().find { it.startsWith(repositoryPrefix) }
          if (!imageRef) {
            error("docker push did not produce an immutable digest for ${env.IMAGE_REPOSITORY}")
          }
          env.IMAGE_REF = imageRef
        }
      }
    }

    stage('Deploy staging') {
      steps {
        sh 'TARGET_ENV=staging IMAGE_REF="$IMAGE_REF" ops/deploy.sh'
      }
    }

    stage('Approve production') {
      steps {
        timeout(time: 1, unit: 'HOURS') {
          input message: "Deploy ${env.IMAGE_REF} to production?", ok: 'Deploy'
        }
      }
    }

    stage('Deploy production') {
      steps {
        sh 'TARGET_ENV=production IMAGE_REF="$IMAGE_REF" ops/deploy.sh'
      }
    }
  }

  post {
    always {
      junit testResults: 'reports/junit.xml', allowEmptyResults: true
    }
  }
}
