---
import BaseLayout from '../layouts/BaseLayout.astro';
import TablerIcon from '../components/TablerIcon.astro';
import { getChangelog } from '../lib/skills';
import { marked } from 'marked';
const changelogHtml = marked.parse(getChangelog());
---
<BaseLayout title="Changelog — Acrazie Skills" description="Historique des versions du monorepo Acrazie Skills.">
  <div class="content-page changelog-page">
    <a class="back-link" href="/#catalogue"><TablerIcon name="chevron-left" size={16} /> Retour au catalogue</a>
    <header class="page-heading">
      <div><h1>Changelog</h1><p>Évolutions du monorepo Acrazie Skills.</p></div>
      <a class="text-action" href="https://github.com/Acrazie/skills/releases" target="_blank" rel="noopener noreferrer">Releases GitHub <TablerIcon name="arrow-up-right" size={16} /></a>
    </header>
    <article class="prose-shadcn changelog-content" set:html={changelogHtml} />
  </div>
</BaseLayout>
