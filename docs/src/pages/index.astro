---
import BaseLayout from '../layouts/BaseLayout.astro';
import AsciiCloudHero from '../components/AsciiCloudHero.astro';
import SkillCard from '../components/SkillCard.astro';
import TablerIcon from '../components/TablerIcon.astro';
import { getAllSkills } from '../lib/skills';

const skills = getAllSkills();
const categories = ['Tout', ...new Set(skills.map((skill) => skill.category))];
---
<BaseLayout
  title="Acrazie Skills — Skills pour agents de code"
  description="Découvrez, consultez et installez des skills spécialisés pour agents de code."
>
  <AsciiCloudHero />
  <section id="catalogue" class="catalogue-section" aria-labelledby="catalogue-title">
    <div class="catalogue-section__heading">
      <div>
        <h2 id="catalogue-title">Trouvez le bon skill.</h2>
        <p>Parcourez les workflows, consultez leurs instructions, puis copiez la commande d'installation.</p>
      </div>
      <p id="results-count" class="catalogue-section__count" aria-live="polite">{skills.length} skills</p>
    </div>

    <div class="catalogue-search">
      <TablerIcon name="search" size={20} />
      <label class="sr-only" for="search-input">Rechercher un skill</label>
      <input id="search-input" type="search" placeholder="Rechercher un skill ou un workflow…" autocomplete="off" />
      <kbd>/</kbd>
    </div>

    <div class="catalogue-filters" role="group" aria-label="Filtrer par catégorie">
      {categories.map((category, index) => (
        <button type="button" class="filter-tag" data-category={category} aria-pressed={index === 0 ? 'true' : 'false'}>{category}</button>
      ))}
    </div>

    <div class="catalogue-columns" aria-hidden="true"><span>Skill</span><span>Description</span><span>Catégorie</span></div>
    <div id="skills-grid" class="skill-list">
      {skills.map((skill) => <SkillCard skill={skill} />)}
    </div>
    <div id="empty-state" class="catalogue-empty" hidden>
      <TablerIcon name="search" size={25} />
      <h3>Aucun skill trouvé</h3>
      <p>Essayez un autre terme ou une autre catégorie.</p>
      <button type="button" id="reset-filters">Réinitialiser les filtres</button>
    </div>
  </section>
</BaseLayout>

<script>
  const searchInput = document.querySelector<HTMLInputElement>('#search-input');
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.filter-tag')];
  const cards = [...document.querySelectorAll<HTMLElement>('.skill-card')];
  const empty = document.querySelector<HTMLElement>('#empty-state');
  const count = document.querySelector<HTMLElement>('#results-count');
  const reset = document.querySelector<HTMLButtonElement>('#reset-filters');
  let category = 'Tout';

  function filter() {
    const query = searchInput?.value.toLocaleLowerCase().trim() || '';
    let visible = 0;
    for (const card of cards) {
      const matchesCategory = category === 'Tout' || card.dataset.category === category;
      const matchesQuery = !query || `${card.dataset.name} ${card.dataset.id} ${card.dataset.desc}`.includes(query);
      card.hidden = !(matchesCategory && matchesQuery);
      if (!card.hidden) visible++;
    }
    if (count) count.textContent = `${visible} skill${visible === 1 ? '' : 's'}`;
    if (empty) empty.hidden = visible !== 0;
  }

  buttons.forEach((button) => button.addEventListener('click', () => {
    category = button.dataset.category || 'Tout';
    buttons.forEach((other) => other.setAttribute('aria-pressed', String(other === button)));
    filter();
  }));
  searchInput?.addEventListener('input', filter);
  reset?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    buttons[0]?.click();
    searchInput?.focus();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === '/' && !(event.target instanceof HTMLInputElement) && !(event.target instanceof HTMLTextAreaElement)) {
      event.preventDefault();
      searchInput?.focus();
    }
  });
</script>
