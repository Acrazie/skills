---
import CopyButton from './CopyButton.astro';
import TablerIcon from './TablerIcon.astro';

const installCommand = 'npx skills add Acrazie/skills';
---

<section class="ascii-hero" aria-labelledby="hero-title">
  <div class="ascii-hero__image" aria-hidden="true"></div>
  <canvas class="ascii-hero__canvas" data-ascii-clouds aria-hidden="true"></canvas>
  <div class="ascii-hero__shade" aria-hidden="true"></div>

  <div class="ascii-hero__inner">
    <div class="ascii-hero__copy">
      <h1 id="hero-title">Des skills précis pour vos agents de code.</h1>
      <p>Explorez des workflows spécialisés, lisez leurs instructions et installez ceux dont votre agent a besoin.</p>
      <div class="ascii-hero__actions">
        <div class="ascii-hero__install">
          <span class="ascii-hero__prompt" aria-hidden="true">$</span>
          <code>{installCommand}</code>
          <CopyButton text={installCommand} label="Copier" size="sm" />
        </div>
        <a class="ascii-hero__explore" href="#catalogue">
          Explorer le catalogue <TablerIcon name="arrow-down" size={17} />
        </a>
      </div>
    </div>
    <button class="ascii-hero__motion" type="button" data-ascii-pause aria-label="Mettre l’animation en pause" aria-pressed="false" hidden>
      <TablerIcon name="player-pause" size={17} />
      <span>Pause</span>
    </button>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('.ascii-hero');
  const canvas = hero?.querySelector<HTMLCanvasElement>('[data-ascii-clouds]');
  const pauseButton = hero?.querySelector<HTMLButtonElement>('[data-ascii-pause]');

  if (hero && canvas && pauseButton) {
    const ctx = canvas.getContext('2d', { alpha: true });
    const source = new Image();
    source.src = '/images/ascii-cloud-source.webp';
    const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
    const sample = document.createElement('canvas');
    const sampleCtx = sample.getContext('2d', { willReadFrequently: true });
    const adjusted = document.createElement('canvas');
    const adjustedCtx = adjusted.getContext('2d');
    const glyphs = document.createElement('canvas');
    const glyphCtx = glyphs.getContext('2d');
    const cellSize = 15;
    const chars = '01:+=*#%@';
    type Cell = { x: number; y: number; luminance: number; r: number; g: number; b: number; char: string };
    let cells: Cell[] = [];
    let width = 0;
    let height = 0;
    let pixelRatio = 1;
    let frame = 0;
    let lastDraw = 0;
    let visible = true;
    let intersecting = true;
    let paused = false;
    let disposed = false;

    function samplePhoto() {
      if (!sampleCtx || !source.complete || !source.naturalWidth || !width || !height) return;
      sample.width = width;
      sample.height = height;
      const scale = Math.max(width / source.naturalWidth, height / source.naturalHeight);
      const drawWidth = source.naturalWidth * scale;
      const drawHeight = source.naturalHeight * scale;
      sampleCtx.clearRect(0, 0, width, height);
      sampleCtx.drawImage(source, (width - drawWidth) / 2, (height - drawHeight) / 2, drawWidth, drawHeight);
      if (adjustedCtx) {
        adjusted.width = width;
        adjusted.height = height;
        adjustedCtx.filter = 'contrast(115%)';
        adjustedCtx.drawImage(sample, 0, 0);
        adjustedCtx.filter = 'none';
      }
      const { data } = sampleCtx.getImageData(0, 0, width, height);
      const next: Cell[] = [];
      for (let y = 0; y < height; y += cellSize) {
        for (let x = Math.floor(width * 0.42 / cellSize) * cellSize; x < width; x += cellSize) {
          let r = 0, g = 0, b = 0, count = 0;
          const endY = Math.min(y + cellSize, height);
          const endX = Math.min(x + cellSize, width);
          for (let sy = y; sy < endY; sy++) {
            for (let sx = x; sx < endX; sx++) {
              const index = (sy * width + sx) * 4;
              r += data[index];
              g += data[index + 1];
              b += data[index + 2];
              count++;
            }
          }
          r /= count; g /= count; b /= count;
          // Preset: brightness 0, contrast 115, saturation 100, grayscale 0, identity tone curve.
          const luminance = Math.max(0, Math.min(1, ((r * .2126 + g * .7152 + b * .0722) / 255 - .5) * 1.15 + .5));
          const charIndex = Math.min(chars.length - 1, Math.floor((1 - luminance) * chars.length));
          next.push({ x, y, luminance, r, g, b, char: chars[charIndex] });
        }
      }
      cells = next;
      draw(0);
    }

    function resize() {
      if (!ctx || !glyphCtx || disposed) return;
      const rect = hero!.getBoundingClientRect();
      width = Math.max(0, Math.floor(rect.width));
      height = Math.max(0, Math.floor(rect.height));
      if (!width || !height) { reconcile(); return; }
      pixelRatio = Math.min(window.devicePixelRatio || 1, 1.5);
      canvas!.width = Math.round(width * pixelRatio);
      canvas!.height = Math.round(height * pixelRatio);
      canvas!.style.width = `${width}px`;
      canvas!.style.height = `${height}px`;
      ctx.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
      glyphs.width = width;
      glyphs.height = height;
      samplePhoto();
      reconcile();
    }

    function draw(time: number) {
      if (!ctx || !glyphCtx || !width || !height) return;
      ctx.clearRect(0, 0, width, height);
      if (adjusted.width) ctx.drawImage(adjusted, 0, 0);
      glyphCtx.clearRect(0, 0, width, height);
      glyphCtx.font = '12px "JetBrains Mono", ui-monospace, monospace';
      glyphCtx.textAlign = 'center';
      glyphCtx.textBaseline = 'middle';
      const phase = time * .001;
      for (const cell of cells) {
        // Full coverage, density 0, edge emphasis 0. Dark cells remain quieter than lit clouds.
        const energy = Math.max(0, (cell.luminance - .16) / .84);
        if (cell.luminance < .1) continue;
        const wave = motionPreference.matches || paused ? 0 : Math.sin(cell.x * .012 + cell.y * .018 - phase * 1.6) * 3.6;
        const shimmer = motionPreference.matches || paused ? 1 : .86 + .14 * Math.sin(phase * 2 + cell.x * .035);
        // Tint #3ca6ff at 32%, drawn with color-dodge over the original photo.
        const r = Math.round((cell.r * .68 + 60 * .32) * .5 + 100 + energy * 55);
        const g = Math.round((cell.g * .68 + 166 * .32) * .4 + 115 + energy * 35);
        const b = Math.min(255, Math.round((cell.b * .68 + 255 * .32) * .4 + 145 + energy * 20));
        glyphCtx.fillStyle = `rgba(${r}, ${g}, ${b}, ${Math.min(1, (.34 + energy * .66) * shimmer)})`;
        glyphCtx.fillText(cell.char, cell.x + cellSize / 2, cell.y + cellSize / 2 + wave);
      }
      ctx.save();
      ctx.globalCompositeOperation = 'color-dodge';
      // Bloom 60: soft copy behind the sharp glyph field.
      ctx.globalAlpha = .27;
      ctx.filter = 'blur(7px)';
      ctx.drawImage(glyphs, 0, 0);
      ctx.filter = 'none';
      ctx.globalAlpha = .94;
      ctx.drawImage(glyphs, 0, 0);
      ctx.restore();
      ctx.save();
      ctx.globalAlpha = .58;
      ctx.drawImage(glyphs, 0, 0);
      ctx.restore();

      // Scan lines 60 and vignette 38 complete the enabled post-effects.
      ctx.fillStyle = 'rgba(0, 5, 13, .09)';
      for (let y = 0; y < height; y += 4) ctx.fillRect(0, y, width, 1);
      const vignette = ctx.createRadialGradient(width * .56, height * .46, width * .1, width * .5, height * .5, width * .75);
      vignette.addColorStop(0, 'rgba(2, 7, 18, 0)');
      vignette.addColorStop(1, 'rgba(2, 7, 18, .38)');
      ctx.fillStyle = vignette;
      ctx.fillRect(0, 0, width, height);
    }

    function tick(time: number) {
      frame = 0;
      if (time - lastDraw >= 40) { draw(time); lastDraw = time; }
      reconcile();
    }

    function reconcile() {
      const shouldAnimate = !disposed && !!ctx && !!glyphCtx && !!cells.length && !!width && !!height && visible && intersecting && !paused && !motionPreference.matches;
      if (shouldAnimate && !frame) frame = requestAnimationFrame(tick);
      else if (!shouldAnimate && frame) { cancelAnimationFrame(frame); frame = 0; }
    }

    function updateMotion() {
      pauseButton!.hidden = motionPreference.matches || !source.naturalWidth;
      draw(0);
      reconcile();
    }
    function updateVisibility() { visible = !document.hidden; reconcile(); }
    function togglePause() {
      paused = !paused;
      pauseButton!.setAttribute('aria-pressed', String(paused));
      pauseButton!.setAttribute('aria-label', paused ? 'Reprendre l’animation' : 'Mettre l’animation en pause');
      pauseButton!.querySelector('span')!.textContent = paused ? 'Reprendre' : 'Pause';
      reconcile();
    }
    function cleanup() {
      disposed = true;
      reconcile();
      observer?.disconnect();
      resizeObserver.disconnect();
      document.removeEventListener('visibilitychange', updateVisibility);
      motionPreference.removeEventListener('change', updateMotion);
      pauseButton!.removeEventListener('click', togglePause);
      window.removeEventListener('pagehide', cleanup);
    }

    const resizeObserver = new ResizeObserver(resize);
    resizeObserver.observe(hero);
    const observer = 'IntersectionObserver' in window ? new IntersectionObserver((entries) => {
      intersecting = entries[0]?.isIntersecting ?? true;
      reconcile();
    }) : null;
    observer?.observe(hero);
    document.addEventListener('visibilitychange', updateVisibility);
    motionPreference.addEventListener('change', updateMotion);
    pauseButton.addEventListener('click', togglePause);
    window.addEventListener('pagehide', cleanup, { once: true });
    source.onload = () => { if (!disposed) { samplePhoto(); updateMotion(); } };
    source.onerror = () => { canvas!.hidden = true; pauseButton!.hidden = true; };
    updateMotion();
    resize();
  }
</script>
