---
import CopyButton from './CopyButton.astro';
import TablerIcon from './TablerIcon.astro';
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const installCommand = 'npx skills add Acrazie/skills';
---

<section class="cloud-hero" aria-labelledby="hero-title">
  <div class="cloud-hero__art" aria-hidden="true"></div>
  <div class="cloud-hero__shade" aria-hidden="true"></div>
  <div class="cloud-hero__inner">
    <div class="cloud-hero__copy">
      <h1 id="hero-title">{t('hero.title')}</h1>
      <p>{t('hero.description')}</p>
      <div class="cloud-hero__actions">
        <div class="cloud-hero__install">
          <span class="cloud-hero__prompt" aria-hidden="true">$</span>
          <code>{installCommand}</code>
          <CopyButton text={installCommand} label={t('hero.copyPrompt')} size="sm" />
        </div>
        <a class="cloud-hero__explore" href="#catalogue">
          {t('hero.explore')} <TablerIcon name="arrow-down" size={17} />
        </a>
      </div>
    </div>
    <button
      class="cloud-hero__motion"
      type="button"
      data-cloud-pause
      data-pause-label={t('hero.pause')}
      data-resume-label={t('hero.resume')}
      aria-label={t('hero.pause')}
      aria-pressed="false"
      hidden
    >
      <TablerIcon name="player-pause" class="cloud-hero__pause-icon" size={17} />
      <TablerIcon name="player-play" class="cloud-hero__play-icon" size={17} />
      <span>Pause</span>
    </button>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('.cloud-hero');
  const pauseButton = hero?.querySelector<HTMLButtonElement>('[data-cloud-pause]');
  if (hero && pauseButton) {
    const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
    const narrowScreen = window.matchMedia('(max-width: 640px)');
    const updatePreference = () => { pauseButton.hidden = motionPreference.matches || narrowScreen.matches; };
    const pauseLabel = pauseButton.dataset.pauseLabel || 'Pause';
    const resumeLabel = pauseButton.dataset.resumeLabel || 'Resume';
    const togglePause = () => {
      const paused = hero.classList.toggle('cloud-hero--paused');
      pauseButton.setAttribute('aria-pressed', String(paused));
      pauseButton.setAttribute('aria-label', paused ? resumeLabel : pauseLabel);
      const textSpan = pauseButton.querySelector('span');
      if (textSpan) textSpan.textContent = paused ? resumeLabel : pauseLabel;
    };
    updatePreference();
    motionPreference.addEventListener('change', updatePreference);
    narrowScreen.addEventListener('change', updatePreference);
    pauseButton.addEventListener('click', togglePause);
  }
</script>

