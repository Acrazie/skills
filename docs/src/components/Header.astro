---
import TablerIcon from './TablerIcon.astro';
interface Props { currentPath?: string }
const { currentPath = '/' } = Astro.props;
---
<header class="site-header">
  <div class="site-header__inner">
    <a class="site-brand" href="/" aria-label="Acrazie Skills, accueil">
      <span class="site-brand__mark" aria-hidden="true">a<span>.</span></span>
      <span>Acrazie <strong>Skills</strong></span>
    </a>
    <nav class="site-nav" aria-label="Navigation principale">
      <a href="/#catalogue" aria-current={currentPath === '/' ? 'page' : undefined}>Catalogue</a>
      <a href="/changelog" aria-current={currentPath.startsWith('/changelog') ? 'page' : undefined}>Changelog</a>
    </nav>
    <div class="site-header__links">
      <a class="site-header__skills" href="https://skills.sh/Acrazie/skills" target="_blank" rel="noopener noreferrer">skills.sh <TablerIcon name="arrow-up-right" size={15} /></a>
      <a class="site-header__github" href="https://github.com/Acrazie/skills" target="_blank" rel="noopener noreferrer" aria-label="Dépôt GitHub Acrazie Skills"><TablerIcon name="brand-github" size={19} /></a>
    </div>
  </div>
</header>
