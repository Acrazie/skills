---
interface Props {
  size?: number;
  class?: string;
}

const { size = 18, class: className = '' } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  aria-hidden="true"
>
  <rect x="13" y="5.5" width="10" height="3.5" rx="1.75" fill="currentColor" />
  <rect x="8" y="11.5" width="18" height="3.5" rx="1.75" fill="currentColor" />
  <rect x="4" y="17.5" width="24" height="3.5" rx="1.75" fill="currentColor" />
  <rect x="7" y="23.5" width="16" height="3.5" rx="1.75" fill="currentColor" />
</svg>
